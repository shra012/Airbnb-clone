{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: npm run dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend-dev"
      }
    },
    {
      "label": "Frontend: npm run dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend-dev"
      }
    },
    {
      "label": "Agent: uvicorn",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port ${AGENT_SERVICE_PORT:-8000}",
      "options": {
        "cwd": "${workspaceFolder}/agent-service"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "agent-dev"
      }
    },
    {
      "label": "Dev: frontend + backend + agent",
      "dependsOn": [
        "Backend: npm run dev",
        "Frontend: npm run dev",
        "Agent: uvicorn"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
