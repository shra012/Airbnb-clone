# Database connection strings (choose the pair that matches your provider)

# MySQL connection (default local development)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/airbnb_lab"
DIRECT_URL="mysql://USER:PASSWORD@localhost:3306/airbnb_lab"

# Supabase PostgreSQL connection (replace [YOUR-PASSWORD])
# DATABASE_URL="postgresql://postgres.dzvxlhmozkpxsdiwozok:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.dzvxlhmozkpxsdiwozok:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:5432/postgres"

# Express configuration
PORT=4000
SESSION_SECRET="replace-me"

# Mongo-backed session store + notification storage (MongoDB Atlas)
# Example: MONGO_SESSION_URI="mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/airbnb_sessions"
MONGO_SESSION_URI=""
# Optional override (defaults to database portion of URI or "airbnb_sessions")
MONGO_DATABASE_NAME="airbnb_sessions"

# Kafka broker (host:port). Use localhost when running backend outside Docker Compose.
KAFKA_BROKER_URL="localhost:29092"
